<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- Configuration and selection of FEIG RFID reader (Single-Reader mode) -->
	<!-- If <readers> is not specified below, this <device> section is used as default reader. -->
	<device>
		<select>feig</select>
		
		<feig>
			<!-- Communication interface: usb (default) -->
			<type>usb</type>

			<!-- Device ID / needed if multiple devices are connected -->
			<!-- <id>52E688</id> -->

			<!-- Optional reader configuration file to load at startup -->
			<!-- <configfile>host.xml</configfile> -->

			<!-- Optional reader configuration file to restore on exit -->
			<!-- <restoreconfig>host.xml</restoreconfig> -->
		</feig>
	</device>

	<!-- Multi-Reader Configuration (Alternative to single <device>) -->
	<!-- When <readers> is defined, rfid-headless initializes dedicated worker threads, -->
	<!-- isolated debounce/presence caches, and targeted WSBroker routing per reader. -->
	<!--
