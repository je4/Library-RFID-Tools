<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- Configuration and selection of FEIG RFID reader -->
	<device>
		<select>feig</select>
		
		<feig>
			<!-- Communication interface: usb (default) -->
			<type>usb</type>

			<!-- Device ID / needed if multiple devices are connected -->
			<!-- <id>52E688</id> -->

			<!-- Optional reader configuration file to load at startup -->
			<!-- <configfile>host.xml</configfile> -->

			<!-- Optional reader configuration file to restore on exit -->
			<!-- <restoreconfig>host.xml</restoreconfig> -->
		</feig>
	</device>

	<!-- Database connection (optional) -->
	<database>
		<active>false</active>
		<dsn><![CDATA[jdbc:mysql://localhost/rfid?user=rfid&password=YOUR_PASSWORD]]></dsn>
		<driver>com.mysql.cj.jdbc.Driver</driver>
	</database>

	<!-- Webservice connection (optional) -->
	<webservice>
		<!-- Enable/disable webservice dispatching (true/false) -->
		<active>false</active>
		<!-- Client ID for identifying the inventory station (e.g., 1, 2, station-a) -->
		<client_id><![CDATA[1]]></client_id>
		<!-- Target URL or URL template with placeholders ({marker}, {session}, {uid}, {raw}, {itemid}, {clientid}, etc.) -->
		<target_url><![CDATA[https://inventory.example.org/api/inventory?clientid={clientid}]]></target_url>
		<!-- HTTP Method: GET or POST -->
		<http_method>POST</http_method>
		<!-- Optional JWT Secret Key for HMAC-SHA256 authentication -->
		<jwt_key><![CDATA[]]></jwt_key>
		<!-- Debug mode: print detailed HTTP request and response information (true/false) -->
		<debug_mode>false</debug_mode>
	</webservice>

	<!-- WSBroker WebSocket connection (optional) -->
	<wsbroker>
		<!-- Enable/disable WSBroker dispatching (true/false) -->
		<active>false</active>

		<!-- Unique client name used for WSBroker authentication and messaging identity -->
		<name>test-java</name>

		<!-- Target WSBroker endpoint URL -->
		<url><![CDATA[https://localhost:8765]]></url>

		<!-- Initial channels to subscribe to upon startup -->
		<channels>
			<channel>all</channel>
			<channel>intern</channel>
		</channels>

		<!-- Client TLS / mTLS configuration with dynamic certificate loading via certmanager (minivault, file, env, dev) -->
		<clienttls>
			<type>minivault</type>

			<minivault>
				<baseurl><![CDATA[https://localhost:8759/api/v1]]></baseurl>
				<parenttoken><![CDATA[pa.22f09dfd1cbfbe9f.c17b29cb2b730533]]></parenttoken>
				<tokentype>client_cert</tokentype>
				<tokenpolicies>
					<policy>wsbroker.client</policy>
				</tokenpolicies>
				<certtype>client_cert</certtype>
				<uris>
					<uri>wsbroker:client:test-java</uri>
					<uri>wsbroker:channel:all</uri>
					<uri>wsbroker:channel:intern</uri>
				</uris>
				<ca>
					<path>../certs/minivault.ca.pem</path>
					<path>certs/minivault.ca.pem</path>
				</ca>
				<usesystempool>false</usesystempool>
			</minivault>
		</clienttls>
	</wsbroker>

	<!-- Number of blocks to read from RFID tag (default: 12) -->
	<numblocks>12</numblocks>

	<!-- Technical tag details and memory configuration -->
	<tagfeatures>
		<tag>
			<name><![CDATA[ISO 15693 : NXP I-Code SLIX]]></name>
			<blocksize>4</blocksize>
			<usermemory>896</usermemory>
			<blocks>32</blocks>
		</tag>
		<tag>
			<name><![CDATA[ISO15693]]></name>
			<blocksize>4</blocksize>
			<usermemory>896</usermemory>
			<blocks>32</blocks>
		</tag>
	</tagfeatures>

	<!-- Configuration for the Inventory application -->
	<inventory>
		<!-- Scan cycle interval in milliseconds (default: 300) -->
		<sleep>300</sleep>
	</inventory>
</configuration>
