<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>windows-x64</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>rfid-headless</baseDirectory>

    <fileSets>
        <!-- Executable run scripts for Windows -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>run-rfid-headless.ps1</include>
            </includes>
            <fileMode>0755</fileMode>
            <lineEnding>windows</lineEnding>
        </fileSet>

        <!-- Configuration & Documentation -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>inventory.xml</include>
                <include>inventory.xml.template</include>
                <include>README.md</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>

        <!-- FEIG SDK Gen3 native Windows x64 libraries -->
        <fileSet>
            <directory>${project.basedir}/../FEIG.ID.SDK.Gen3.Java-v7.1.0/windows.x64/bin</directory>
            <outputDirectory>lib/native/x64</outputDirectory>
            <includes>
                <include>*.dll</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- Bundled FEIG SDK JARs -->
        <fileSet>
            <directory>${project.basedir}/../FEIG.ID.SDK.Gen3.Java-v7.1.0/jar</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>

    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>false</unpack>
            <scope>runtime</scope>
            <excludes>
                <exclude>org.junit.jupiter:*</exclude>
                <exclude>org.assertj:*</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
</assembly>
